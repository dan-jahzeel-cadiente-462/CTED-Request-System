{% extends 'kiosk/base.html.twig' %}

{% block title %}CTED - Student Request & Access Kiosk
{% endblock %}

{% block body %}
	<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4 py-8">
		<div
			class="bg-white w-full max-w-lg p-8 rounded-3xl shadow-xl border border-slate-100">

			<!-- Header Section -->
			<div
				class="flex flex-col items-center mb-10">
				<!-- Logo Container (resized from w-20 h-20 to w-16 h-16) -->
				<div class="w-24 h-24 mb-4 flex items-center justify-center rounded-full shadow-inner overflow-hidden">
					<!-- <i class="fa-solid fa-graduation-cap text-blue-600 text-3xl"></i> -->
					<!-- Image (resized from w-20 h-20 to w-10 h-10, added object-contain) -->
				<img
					src="{{ asset('images/CTED.png') }}" alt="Logo" class="w-24 h-24 object-contain"> <!-- Alternative smaller size: class="w-12 h-12 object-contain" -->
				</div>
				<h1 class="text-xl font-bold text-slate-800 tracking-tight">Access & Request Kiosk</h1>
			</div>

			<!-- Form Section -->
			<form
				class="space-y-6" onsubmit="event.preventDefault();">

				<!-- Student ID Field -->
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Student ID</label>
					<input id="studentId" type="text" placeholder="" class="w-full pb-2 border-b border-slate-300 focus:border-blue-500 focus:outline-none text-slate-700 bg-transparent transition-colors">
				</div>

				<!-- Full Name Field -->
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Full Name</label>
					<input type="text" placeholder="" class="w-full pb-2 border-b border-slate-300 focus:border-blue-500 focus:outline-none text-slate-700 bg-transparent transition-colors">
				</div>

				<!-- Contact Number & Program/Year Grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Contact Number</label>
						<input type="text" placeholder="" class="w-full pb-2 border-b border-slate-300 focus:border-blue-500 focus:outline-none text-slate-700 bg-transparent transition-colors">
					</div>
					<div>
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 transition-colors group-focus-within:text-blue-600 mb-1">
							Program/Year
						</label>
						<div class="relative group">
							<select class="w-full pb-2 pr-6 text-sm font-medium text-slate-700 bg-transparent border-b border-slate-200 appearance-none cursor-pointer transition-colors hover:border-slate-400 focus:border-blue-600 focus:outline-none">
								{% for case in programOptions %}
									<option value="{{ case.value }}" class="text-slate-800 bg-white py-1">{{ case.label() }}</option>
								{% endfor %}
							</select>
							<div class="absolute right-0 bottom-2 pointer-events-none text-slate-400 transition-transform duration-200 group-focus-within:rotate-180 group-focus-within:text-blue-600">
								<i class="fa-solid fa-chevron-down text-xs"></i>
							</div>
						</div>
					</div>
				</div>

				<!-- Common Request Select Field -->
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 transition-colors group-focus-within:text-blue-600 mb-1">
						Common Request
					</label>
					<div class="relative group">
						<select id="common-request-select" class="w-full pb-2 pr-6 text-sm font-medium text-slate-700 bg-transparent border-b border-slate-200 appearance-none cursor-pointer transition-colors hover:border-slate-400 focus:border-blue-600 focus:outline-none">
							{% for case in enum('App\\Enum\\CommonRequest').cases %}
								<option value="{{ case.value }}" class="text-slate-800 bg-white py-1">{{ case.label() }}</option>
							{% endfor %}
						</select>
						<div class="absolute right-0 bottom-2 pointer-events-none text-slate-400 transition-transform duration-200 group-focus-within:rotate-180 group-focus-within:text-blue-600">
							<i class="fa-solid fa-chevron-down text-xs"></i>
						</div>
					</div>
				</div>

				{% include 'kiosk/partials/checkboxes/device_request.html.twig' with { devices: deviceOptions } %}
				{% include 'kiosk/partials/checkboxes/cert_of_employment.html.twig' with { employmentCert: employmentCertOptions } %}
				{% include 'kiosk/partials/inputs/other_purposes.html.twig' with { commonRequest: commonRequestOptions } %}

				<!-- Submit Button Area -->
				<div class="flex justify-end">
					<button class="font-bold inline-block cursor-pointer items-center justify-center rounded-xl border-[1.58px] border-zinc-600 bg-zinc-950 px-5 py-3 font-medium text-slate-200 shadow-md transition-all duration-300 hover:[transform:translateY(-.335rem)] hover:shadow-xl">
						Submit
					</button>
				</div>

			</form>

				<script src="{{ asset('scripts/student-kiosk.js') }}"></script>
	{% endblock %}
