{% extends 'base.html.twig' %}

{% block title %}Admin -
	{% block admin_title %}{% endblock %}
{% endblock %}

{% block body_class %}bg-slate-100 min-h-screen text-slate-900
{% endblock %}

{% block body %}
	<div class="min-h-screen flex bg-slate-100 text-slate-900">
		{% include 'admin/partials/sidebar.html.twig' %}

		<div class="flex-1 flex flex-col min-w-0 lg:pl-[264px]">
			<header class="border-b border-slate-200 bg-white px-6 py-5">
				<div class="max-w-7xl mx-auto flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
					<div>
						<p class="text-sm uppercase tracking-[0.28em] text-slate-500">Admin</p>
						<h1 class="mt-2 text-3xl font-semibold text-slate-900">
							{% block admin_heading %}{% endblock %}
						</h1>
						{% block page_subheading %}{% endblock %}
					</div>
					<div class="flex flex-wrap items-center gap-3">
						{% block page_actions %}{% endblock %}
					</div>
				</div>
			</header>

			<main class="flex-1 overflow-y-auto p-6">
				<div class="max-w-7xl mx-auto">
					{% block admin_body %}{% endblock %}
				</div>
			</main>
		</div>
	</div>
{% endblock %}
