{% extends 'base.html.twig' %}

{% block title %}Admin -
	{% block admin_title %}{% endblock %}
{% endblock %}

{% block body_class %}bg-slate-100 min-h-screen text-slate-900
{% endblock %}

{% block body %}
	<div class="min-h-screen flex bg-slate-100 text-slate-900">
		{% include 'admin/partials/sidebar.html.twig' %}

		<div class="flex-1 flex flex-col min-w-0 lg:pl-[264px]">
			{% include 'admin/partials/header.html.twig' %}

			<main class="flex-1 overflow-y-auto p-6">
				<div class="max-w-7xl mx-auto">
					{% block admin_body %}{% endblock %}
				</div>
			</main>
		</div>
	</div>
{% endblock %}
