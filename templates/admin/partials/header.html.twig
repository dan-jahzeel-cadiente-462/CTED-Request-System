<header class="border-b border-slate-200 bg-white px-2 py-2">
    <div class="max-w-7xl mx-auto flex flex-col">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between"></div>

        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-end">
            <!-- Search container with correct padding on the right for the search button -->
            <div class="w-full max-w-sm min-w-[200px]">
                <div class="relative flex items-center">
                    <input
                        class="w-full bg-transparent placeholder:text-slate-400 text-slate-700 text-xs border border-slate-200 rounded-md pl-3 pr-24 py-2 transition duration-300 ease focus:outline-none focus:border-slate-400 hover:border-slate-300 shadow-sm focus:shadow"
                        placeholder="Search..." 
                    />
                    <button
                        class="absolute right-1 top-1 bottom-1 flex items-center rounded bg-slate-800 py-1 px-2.5 border border-transparent text-center text-sm text-white transition-all shadow-sm hover:shadow focus:bg-slate-700 active:bg-slate-700 hover:bg-slate-700 disabled:pointer-events-none disabled:opacity-50"
                        type="button"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                            <path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z" clip-rule="evenodd" />
                        </svg>
                        
                    </button> 
                </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-3">
                {% block page_actions %}{% endblock %}
            </div>
        </div>
    </div>
</header>