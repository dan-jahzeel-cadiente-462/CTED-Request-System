{% extends 'admin/base.html.twig' %}

{% block admin_title %}Reports{% endblock %}

{% block admin_body %}
<div class="space-y-6">
    <section class="rounded-3xl bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm uppercase tracking-[0.28em] text-slate-500">Request Reports</p>
                <h1 class="mt-2 text-2xl font-semibold text-slate-900">Daily request reports</h1>
                <p class="mt-2 text-sm text-slate-600">Select a date to view requests, preview the report as PDF, or export the selected day.</p>
            </div>
        </div>

        <div class="mt-6 rounded-3xl bg-slate-50 p-6">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <div class="text-md font-semibold text-slate-900">{{ calendarMonth }} {{ calendarYear }}</div>
                </div>
                <div class="flex gap-2">
                    <a href="{{ path('app_admin_reports', {month: prevMonth}) }}" class="inline-flex h-9 w-9 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50">←</a>
                    <a href="{{ path('app_admin_reports', {month: nextMonth}) }}" class="inline-flex h-9 w-9 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50">→</a>
                </div>
            </div>

            <div class="mt-4 rounded-3xl border border-slate-200 bg-slate-50 p-4">
                <div class="grid grid-cols-7 gap-2 text-center text-[11px] font-semibold uppercase tracking-[0.24em] text-slate-500">
                    <div>Mon</div>
                    <div>Tue</div>
                    <div>Wed</div>
                    <div>Thu</div>
                    <div>Fri</div>
                    <div>Sat</div>
                    <div>Sun</div>
                </div>
                <div class="mt-3 grid grid-cols-7 gap-2">
                    {% for week in calendarWeeks %}
                        {% for day in week %}
                            <div class="min-h-[88px] rounded-2xl border px-2 py-2 text-left transition {{ day.inMonth ? 'bg-white' : 'bg-slate-100 text-slate-400' }}">
                                {% set dayKey = day.date.format('Y-m-d') %}
                                {% if day.hasReport %}
                                    <a href="{{ path('app_admin_reports', {date: dayKey, month: day.date.format('Y-m')}) }}" class="group block h-full rounded-2xl p-2 transition {{ selectedDate and selectedDate|date('Y-m-d') == dayKey ? 'border-slate-900 bg-slate-900 text-white' : 'border border-slate-200 bg-white text-slate-900 hover:border-slate-300 hover:bg-slate-50' }}">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-sm font-semibold">{{ day.date.format('j') }}</span>
                                            <span class="inline-flex h-6 min-w-[22px] items-center justify-center rounded-full {{ selectedDate and selectedDate|date('Y-m-d') == dayKey ? 'bg-white/20 text-white' : 'bg-slate-100' }} px-2 text-[10px] font-semibold text-slate-700">{{ day.reportCount }}</span>
                                        </div>
                                        <div class="mt-2 text-[11px] text-slate-500">Report</div>
                                    </a>
                                {% else %}
                                    <div class="rounded-2xl p-2 text-sm {{ selectedDate and selectedDate|date('Y-m-d') == dayKey ? 'bg-slate-100 border border-slate-200' : '' }}">
                                        <div class="text-sm font-semibold">{{ day.date.format('j') }}</div>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-[320px_minmax(0,1fr)]">
            <div class="space-y-6">
                <div class="rounded-3xl bg-slate-50 p-6">
                    <h3 class="text-sm font-semibold text-slate-900">Date selection</h3>
                    <p class="mt-2 text-sm text-slate-600">Pick a report date from the calendar or the list below.</p>

                    <form method="get" action="{{ path('app_admin_reports') }}" class="mt-6 space-y-4">
                        <label for="report-date" class="block text-sm font-medium text-slate-700">Pick report date</label>
                        <input
                            id="report-date"
                            name="date"
                            type="date"
                            value="{{ selectedDate ? selectedDate|date('Y-m-d') : '' }}"
                            {% if minReportDate and maxReportDate %}min="{{ minReportDate|date('Y-m-d') }}" max="{{ maxReportDate|date('Y-m-d') }}"{% endif %}
                            class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-200"
                        />
                        <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">View report</button>
                    </form>
                </div>

                <div class="rounded-3xl bg-slate-50 p-6">
                    <h3 class="text-sm font-semibold text-slate-900">Recent report dates</h3>
                    <p class="mt-2 text-sm text-slate-600">Quick access to recent report days.</p>
                    <div class="mt-4 space-y-3">
                        {% for report in reportDates %}
                            <a href="{{ path('app_admin_reports', {date: report.date|date('Y-m-d')}) }}" class="flex items-center justify-between rounded-2xl border px-4 py-3 text-sm text-slate-700 transition-colors {% if selectedDate and selectedDate|date('Y-m-d') == report.date|date('Y-m-d') %}border-slate-900 bg-slate-900 text-white hover:border-slate-900 hover:bg-slate-800{% else %}border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50{% endif %}">
                                <span>{{ report.date ? report.date|date('F j, Y') : 'Unknown date' }}</span>
                                <span class="text-xs font-semibold {{ selectedDate and selectedDate|date('Y-m-d') == report.date|date('Y-m-d') ? 'text-white/80' : 'text-slate-500' }}">{{ report.count }} requests</span>
                            </a>
                        {% else %}
                            <div class="rounded-2xl border border-slate-200 bg-white px-4 py-4 text-sm text-slate-500">No report dates available.</div>
                        {% endfor %}
                    </div>

                    {% if totalPages > 1 %}
                        <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
                            {% if currentPage > 1 %}
                                <a href="{{ path('app_admin_reports', {page: currentPage - 1}) }}" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-700 hover:bg-slate-100">← Prev</a>
                            {% endif %}
                            {% for p in 1..totalPages %}
                                <a href="{{ path('app_admin_reports', {page: p}) }}" class="inline-flex items-center justify-center min-w-[32px] rounded-full px-3 py-1 {{ p == currentPage ? 'bg-slate-900 text-white' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100' }}">{{ p }}</a>
                            {% endfor %}
                            {% if currentPage < totalPages %}
                                <a href="{{ path('app_admin_reports', {page: currentPage + 1}) }}" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-700 hover:bg-slate-100">Next →</a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="space-y-6">
                <div class="rounded-3xl bg-slate-50 p-6">
                    {% if selectedDate %}
                        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                            <div>
                                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Selected date</p>
                                <h2 class="mt-2 text-xl font-semibold text-slate-900">{{ selectedDate|date('F j, Y') }}</h2>
                                <p class="mt-1 text-sm text-slate-600">{{ requests|length }} request{{ requests|length == 1 ? '' : 's' }} on this day.</p>
                            </div>
                            <div class="relative" x-data="{ open: false }">
                                <button
                                    type="button"
                                    class="inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
                                    @click="open = !open"
                                    @keydown.escape.window="open = false"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M10 2a6 6 0 0 1 5.92 5.06 4.5 4.5 0 0 1-1.5 8.8.75.75 0 0 1-.42-.07A5.5 5.5 0 0 1 10 17a5.5 5.5 0 0 1-4-1.21.75.75 0 0 1-.42.07 4.5 4.5 0 0 1-1.5-8.8A6 6 0 0 1 10 2Z" /></svg>
                                    Export
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition-transform" :class="open ? 'rotate-180' : ''"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
                                </button>
                                <div
                                    class="absolute right-0 z-20 mt-2 w-56 origin-top-right rounded-2xl border border-slate-200 bg-white p-2 shadow-lg"
                                    x-show="open"
                                    @click.outside="open = false"
                                    x-transition
                                    x-cloak
                                >
                                    <a href="{{ path('app_admin_reports', {date: selectedDate|date('Y-m-d'), format: 'pdf'}) }}" target="_blank" rel="noopener" class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-slate-700 hover:bg-slate-100" @click="open = false">
                                        <span class="text-base">📄</span> View PDF
                                    </a>
                                    <a href="{{ path('app_admin_reports_export_csv', {date: selectedDate|date('Y-m-d')}) }}" class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-slate-700 hover:bg-slate-100" @click="open = false">
                                        <span class="text-base">📊</span> Export CSV
                                    </a>
                                    <a href="{{ path('app_admin_reports_export_excel', {date: selectedDate|date('Y-m-d')}) }}" class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-slate-700 hover:bg-slate-100" @click="open = false">
                                        <span class="text-base">📗</span> Export Excel
                                    </a>
                                    <a href="{{ path('app_admin_reports_export_json', {date: selectedDate|date('Y-m-d')}) }}" class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-slate-700 hover:bg-slate-100" @click="open = false">
                                        <span class="text-base">🔗</span> Export JSON
                                    </a>
                                    <div class="my-1 border-t border-slate-100"></div>
                                    <!--
                                    <button type="button" class="flex w-full items-center gap-3 rounded-xl px-3 py-2 text-sm text-slate-700 hover:bg-slate-100" @click="open = false; window.print()">
                                        <span class="text-base">🖨️</span> Print
                                    </button>
                                    -->
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
                            Choose a report date from the calendar to display requests and export them.
                        </div>
                    {% endif %}
                </div>

                <div class="rounded-3xl bg-slate-50 p-6 overflow-x-auto">
                    {% if selectedDate %}
                        <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                            <thead class="bg-slate-100 text-slate-700 uppercase tracking-[0.16em] text-[11px]">
                                <tr>
                                    <th class="px-4 py-3">Student</th>
                                    <th class="px-4 py-3">Program</th>
                                    <th class="px-4 py-3">Request Type</th>
                                    <th class="px-4 py-3">Status</th>
                                    <th class="px-4 py-3">Time in</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 bg-white">
                                {% for request in requests %}
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-4 py-4 text-slate-700">{{ request.fullName }}</td>
                                        <td class="px-4 py-4 text-slate-700">{{ request.program }}</td>
                                        <td class="px-4 py-4 text-slate-700">{{ request.requestType }}</td>
                                        <td class="px-4 py-4">
                                            <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold {{ request.status == 'Completed' ? 'bg-emerald-100 text-emerald-700' : request.status == 'Cancelled' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-700' }}">
                                                {{ request.status ?: 'Pending' }}
                                            </span>
                                        </td>
                                        <td class="px-4 py-4 text-slate-700">{{ request.timeIn ? request.timeIn|date('g:i a') : '-' }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="px-4 py-8 text-center text-slate-500">No requests were submitted for this date.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    [x-cloak] { display: none !important; }
</style>
{% endblock %}
