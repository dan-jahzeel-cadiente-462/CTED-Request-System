{% extends 'admin/base.html.twig' %}

{% block admin_title %}Report PDF{% endblock %}

{% block body %}
    <div style="font-family: Arial, sans-serif; font-size: 12px; color: #1f2937;">
        <h1 style="font-size: 24px; margin-bottom: 8px;">Request Report</h1>
        <p style="margin-bottom: 24px;">Date: {{ date|date('F j, Y') }}</p>

        <table width="100%" cellpadding="8" cellspacing="0" style="border-collapse: collapse;">
            <thead>
                <tr>
                    <th align="left" style="border-bottom: 2px solid #d1d5db; text-transform: uppercase; font-size: 11px; letter-spacing: .08em;">Student</th>
                    <th align="left" style="border-bottom: 2px solid #d1d5db; text-transform: uppercase; font-size: 11px; letter-spacing: .08em;">Program</th>
                    <th align="left" style="border-bottom: 2px solid #d1d5db; text-transform: uppercase; font-size: 11px; letter-spacing: .08em;">Request Type</th>
                    <th align="left" style="border-bottom: 2px solid #d1d5db; text-transform: uppercase; font-size: 11px; letter-spacing: .08em;">Status</th>
                    <th align="left" style="border-bottom: 2px solid #d1d5db; text-transform: uppercase; font-size: 11px; letter-spacing: .08em;">Time in</th>
                </tr>
            </thead>
            <tbody>
                {% for request in requests %}
                    <tr>
                        <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">{{ request.fullName }}</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">{{ request.program }}</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">{{ request.requestType }}</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">{{ request.status ?: 'Pending' }}</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">{{ request.timeIn ? request.timeIn|date('g:i a') : '-' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="padding: 16px 0; text-align: center; color: #6b7280;">No requests found for this date.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
