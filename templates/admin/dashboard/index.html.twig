{% extends 'admin/base.html.twig' %}
{% from 'admin/partials/_components.html.twig' import stat_card %}

{% block admin_title %}Dashboard{% endblock %}

{% block page_actions %}
    {% include 'admin/partials/page_actions.html.twig' %}
{% endblock %}

{% block admin_body %}
<div class="space-y-6">
    <section class="grid gap-6 xl:grid-cols-[1.8fr_1fr]">
        <article class="rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-700 p-8 text-white shadow-xl shadow-indigo-500/10">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <p class="text-sm uppercase tracking-[0.3em] text-slate-300">Welcome back</p>
                    <h2 class="mt-3 text-4xl font-semibold">Your admin summary</h2>
                </div>
                <div class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-slate-100">Live dashboard</div>
            </div>
            <div class="mt-8 grid gap-4 sm:grid-cols-3">
                <div class="rounded-3xl bg-white/10 p-5">
                    <p class="text-sm text-slate-300">Pending requests</p>
                    <p class="mt-3 text-3xl font-semibold">{{ pendingCount }}</p>
                </div>
                <div class="rounded-3xl bg-white/10 p-5">
                    <p class="text-sm text-slate-300">Completed requests</p>
                    <p class="mt-3 text-3xl font-semibold">{{ completedCount }}</p>
                </div>
                <div class="rounded-3xl bg-white/10 p-5">
                    <p class="text-sm text-slate-300">Cancelled requests</p>
                    <p class="mt-3 text-3xl font-semibold">{{ cancelledCount }}</p>
                </div>
            </div>
        </article>

        <div class="grid gap-4">
            <article class="rounded-3xl bg-white p-6 shadow-sm">
                <p class="text-sm uppercase tracking-[0.28em] text-slate-500">Today's activity</p>
                <h3 class="mt-4 text-xl font-semibold text-slate-900">Requests and queue trends</h3>
                <p class="mt-3 text-slate-600">Quick access to the latest request stats and workflow status.</p>
            </article>
            <article class="rounded-3xl bg-white p-6 shadow-sm">
                <p class="text-sm uppercase tracking-[0.28em] text-slate-500">Admin tools</p>
                <div class="mt-5 space-y-3">
                    <div class="rounded-3xl bg-slate-950 p-4 text-slate-100">
                        <p class="text-sm text-slate-300">Manage user roles, approvals, and request flows.</p>
                    </div>
                    <div class="rounded-3xl bg-slate-950 p-4 text-slate-100">
                        <p class="text-sm text-slate-300">Review request details and respond faster.</p>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
        {{ stat_card('Pending', '14', 'Requests waiting for review.') }}
        {{ stat_card('Processing', '8', 'Requests currently being processed.') }}
        {{ stat_card('Completed', '18', 'Requests completed today.') }}
    </section>
</div>
{% endblock %}
