{% extends 'admin/base.html.twig' %}

{% block admin_title %}Request Detail{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_admin_requests', {page: currentPage}) }}" class="inline-flex items-center rounded-2xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">Back to list</a>
{% endblock %}

{% block admin_body %}
<div class="space-y-6">
    <section class="rounded-3xl bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
            <div>
                <p class="text-sm uppercase tracking-[0.28em] text-slate-500">Request Details</p>
                <h1 class="mt-2 text-2xl font-semibold text-slate-900">{{ requestEntity.fullName }}</h1>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('app_admin_requests', {page: currentPage}) }}" class="inline-flex items-center rounded-2xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">Back to list</a>
            </div>
        </div>

        <div class="mt-6 grid gap-4 lg:grid-cols-2">
            <div class="rounded-3xl bg-slate-50 p-5">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Student</p>
                <dl class="mt-4 space-y-4 text-sm text-slate-700">
                    <div>
                        <dt class="font-semibold text-slate-900">Student ID</dt>
                        <dd>{{ requestEntity.studentId }}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-slate-900">Contact</dt>
                        <dd>{{ requestEntity.contactNo }}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-slate-900">Program</dt>
                        <dd>{{ requestEntity.program }}</dd>
                    </div>
                </dl>
            </div>

            <div class="rounded-3xl bg-slate-50 p-5">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Request</p>
                <dl class="mt-4 space-y-4 text-sm text-slate-700">
                    <div>
                        <dt class="font-semibold text-slate-900">Type</dt>
                        <dd>{{ requestEntity.requestType }}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-slate-900">Status</dt>
                        <dd>{{ requestEntity.status ?: 'Pending' }}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-slate-900">Time in</dt>
                        <dd>{{ requestEntity.timeIn ? requestEntity.timeIn|date('F j, Y H:i') : '-' }}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-slate-900">Time out</dt>
                        <dd>{{ requestEntity.timeOut ? requestEntity.timeOut|date('F j, Y H:i') : 'Not recorded' }}</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="mt-6 rounded-3xl bg-slate-50 p-5">
            <div class="flex items-center justify-between gap-4 pb-4 border-b border-slate-200">
                <div>
                    <p class="text-xs uppercase tracking-[0.2em] text-slate-500">INVENTORY</p>
                    <p class="mt-1 text-sm text-slate-600">Review requested devices below.</p>
                </div>
                <div>
                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold bg-slate-100 text-slate-700">{{ requestEntity.status ?: 'Pending' }}</span>
                </div>
            </div>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {% for item in requestEntity.deviceRequestItems %}
                    <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
                        <p class="font-semibold text-slate-900">{{ item.name }}</p>
                        {% if item.description is defined and item.description %}
                            <p class="mt-2 text-sm text-slate-500">{{ item.description }}</p>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="rounded-3xl bg-white border border-slate-200 p-4 text-slate-500">No device items recorded for this request.</div>
                {% endfor %}
            </div>
        </div>

        <div class="mt-6 grid gap-4 lg:grid-cols-2">
            <div class="rounded-3xl bg-slate-50 p-5">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Status history</p>
                <div class="mt-4 space-y-3 text-sm text-slate-700">
                    {% for status in requestEntity.statuses %}
                        <div class="rounded-2xl bg-white border border-slate-200 p-4">
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <p class="font-semibold text-slate-900">{{ status.status }}</p>
                                    <p class="text-xs text-slate-500">{{ status.createdAt ? status.createdAt|date('M d, Y H:i') : '-' }}</p>
                                </div>
                                <span class="text-xs text-slate-500">{{ status.processedBy ?: 'Admin' }}</span>
                            </div>
                            {% if status.note %}
                                <p class="mt-3 text-slate-600">{{ status.note }}</p>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="rounded-2xl bg-white border border-slate-200 p-4 text-slate-500">No status updates yet.</div>
                    {% endfor %}
                </div>
            </div>

            <div class="rounded-3xl bg-slate-50 p-5">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Take action</p>
                <form action="{{ path('app_admin_requests_status', {id: requestEntity.id}) }}" method="post" class="mt-4 space-y-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('status-request' ~ requestEntity.id) }}">
                    <input type="hidden" name="page" value="{{ currentPage }}">
                    <div>
                        <label class="text-sm font-semibold text-slate-900" for="status">Status</label>
                        <select id="status" name="status" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm text-slate-900 focus:border-slate-500 focus:outline-none">
                            {% for choice in statusChoices %}
                                <option value="{{ choice }}" {{ requestEntity.status == choice ? 'selected' : '' }}>{{ choice }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-slate-900" for="note">Note</label>
                        <textarea id="note" name="note" rows="4" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm text-slate-900 focus:border-slate-500 focus:outline-none" placeholder="Add a note for this action"></textarea>
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-slate-900" for="processedBy">Processed by</label>
                        <input id="processedBy" name="processedBy" type="text" value="Admin" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm text-slate-900 focus:border-slate-500 focus:outline-none" />
                    </div>
                    <button type="submit" class="inline-flex items-center rounded-2xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">Update status</button>
                </form>
            </div>
        </div>
    </section>
</div>
{% endblock %}
