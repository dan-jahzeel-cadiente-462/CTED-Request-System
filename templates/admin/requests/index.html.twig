{% extends 'admin/base.html.twig' %}

{% block admin_title %}Requests{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_admin_requests') }}" class="inline-flex items-center rounded-2xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">Refresh</a>
{% endblock %}

{% block admin_body %}
<div class="space-y-6">
    <section class="rounded-3xl bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm uppercase tracking-[0.28em] text-slate-500">Student Requests</p>
                <h1 class="mt-2 text-2xl font-semibold text-slate-900">All requests</h1>
                <p class="mt-2 text-sm text-slate-600">Showing page {{ currentPage }} of {{ totalPages }} ({{ totalRequests }} total requests).</p>
            </div>
        </div>

        <form method="get" action="{{ path('app_admin_requests') }}" class="mt-6">
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                <div>
                    <label class="block text-sm font-medium text-slate-700">Program</label>
                    <select name="program" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-200">
                        <option value="">All programs</option>
                        {% for program in programOptions %}
                            <option value="{{ program }}" {% if filters.program == program %}selected{% endif %}>{{ program }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">Status</label>
                    <select name="status" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-200">
                        <option value="">All statuses</option>
                        {% for status in statusOptions %}
                            <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">Request Type</label>
                    <select name="requestType" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-200">
                        <option value="">All request types</option>
                        {% for requestType in requestTypeOptions %}
                            <option value="{{ requestType }}" {% if filters.requestType == requestType %}selected{% endif %}>{{ requestType }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">Student ID</label>
                    <input type="text" name="studentId" value="{{ filters.studentId }}" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-200" placeholder="Student ID" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">Student Name</label>
                    <input type="text" name="fullName" value="{{ filters.fullName }}" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-200" placeholder="Student name" />
                </div>
                <div class="flex items-end gap-2">
                    <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800">Filter</button>
                    <a href="{{ path('app_admin_requests') }}" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">Reset</a>
                </div>
            </div>
        </form>

        <div class="mt-6" data-controller="collapsible">
            <button type="button" data-action="click->collapsible#toggle" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                <span>Advanced Options</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
            </button>

            <div data-collapsible-target="content" class="hidden mt-4 grid gap-6 md:grid-cols-2">
                <div class="rounded-3xl bg-slate-50 p-5">
                    <h3 class="text-sm font-semibold text-slate-900">Export Requests</h3>
                    <p class="mt-1 text-sm text-slate-600">Export filtered requests to a file.</p>
                    <div class="mt-4 space-x-2">
                        <a href="{{ path('app_admin_requests_export_sql', filters) }}" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Export as SQL</a>
                        <a href="{{ path('app_admin_requests_export_csv', filters) }}" class="inline-flex items-center justify-center rounded-2xl bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700">Export as CSV</a>
                    </div>
                </div>
                <div class="rounded-3xl bg-slate-50 p-5">
                    <h3 class="text-sm font-semibold text-slate-900">Import Requests</h3>
                    <p class="mt-1 text-sm text-slate-600">Import requests from a SQL file.</p>
                    <form action="{{ path('app_admin_requests_import_sql') }}" method="post" enctype="multipart/form-data" class="mt-4 flex items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('import-sql-requests') }}">
                        <input type="file" name="sqlFile" required class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-white file:text-slate-700 hover:file:bg-slate-50"/>
                        <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">Import</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="mt-4 overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                <thead class="bg-slate-50 text-slate-700 uppercase tracking-[0.16em] text-[11px]">
                    <tr>
                        <th class="px-4 py-3">Student ID</th>
                        <th class="px-4 py-3">Name</th>
                        <th class="px-4 py-3">Program</th>
                        <th class="px-4 py-3">Request Type</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">Time in</th>
                        <th class="px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for request in requests %}
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-slate-700">{{ request.studentId }}</td>
                            <td class="px-4 py-4 text-slate-700">{{ request.fullName }}</td>
                            <td class="px-4 py-4 text-slate-700">{{ request.program }}</td>
                            <td class="px-4 py-4 text-slate-700">{{ request.requestType }}</td>
                            <td class="px-4 py-4">
                                <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold {{ request.status == 'Completed' ? 'bg-emerald-100 text-emerald-700' : request.status == 'Cancelled' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-700' }}">
                                    {{ request.status ?: 'Pending' }}
                                </span>
                            </td>
                            <td class="px-4 py-4 text-slate-700">{{ request.timeIn ? request.timeIn|date('M d, Y H:i') : '-' }}</td>
                            <td class="px-4 py-4 text-slate-700">
                                <div class="flex flex-wrap gap-2">
                                    <a href="{{ path('app_admin_requests_show', {id: request.id, page: currentPage}) }}" class="rounded-md bg-blue-500 px-3 py-1 text-xs font-semibold text-white hover:bg-blue-600">View</a>
                                    <form action="{{ path('app_admin_requests_delete', {id: request.id}) }}" method="post" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-request' ~ request.id) }}">
                                        <input type="hidden" name="page" value="{{ currentPage }}">
                                        <button type="submit" class="rounded-md bg-rose-500 px-3 py-1 text-xs font-semibold text-white hover:bg-rose-600" onclick="return confirm('Delete this request?');">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-4 py-8 text-center text-slate-500">No requests found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if totalPages > 1 %}
            <nav class="mt-6 flex flex-wrap items-center gap-2 text-sm" aria-label="Pagination">
                {% for page in 1..totalPages %}
                    <a href="{{ path('app_admin_requests', filters|merge({'page': page})) }}" class="inline-flex items-center justify-center rounded-full px-4 py-2 {{ page == currentPage ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' }}">{{ page }}</a>
                {% endfor %}
            </nav>
        {% endif %}
    </section>
</div>
{% endblock %}
