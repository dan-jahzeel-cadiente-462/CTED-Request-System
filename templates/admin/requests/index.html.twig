{% extends 'admin/base.html.twig' %}

{% block admin_title %}Requests{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_admin_requests') }}" class="inline-flex items-center rounded-2xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">Refresh</a>
{% endblock %}

{% block admin_body %}
<div class="space-y-6">
    <section class="rounded-3xl bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm uppercase tracking-[0.28em] text-slate-500">Student Requests</p>
                <h1 class="mt-2 text-2xl font-semibold text-slate-900">All requests</h1>
                <p class="mt-2 text-sm text-slate-600">Showing page {{ currentPage }} of {{ totalPages }} ({{ totalRequests }} total requests).</p>
            </div>
        </div>

        <div class="mt-6 overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                <thead class="bg-slate-50 text-slate-700 uppercase tracking-[0.16em] text-[11px]">
                    <tr>
                        <th class="px-4 py-3">Student ID</th>
                        <th class="px-4 py-3">Name</th>
                        <th class="px-4 py-3">Program</th>
                        <th class="px-4 py-3">Request Type</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">Time in</th>
                        <th class="px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for request in requests %}
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-slate-700">{{ request.studentId }}</td>
                            <td class="px-4 py-4 text-slate-700">{{ request.fullName }}</td>
                            <td class="px-4 py-4 text-slate-700">{{ request.program }}</td>
                            <td class="px-4 py-4 text-slate-700">{{ request.requestType }}</td>
                            <td class="px-4 py-4">
                                <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold {{ request.status == 'Completed' ? 'bg-emerald-100 text-emerald-700' : request.status == 'Cancelled' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-700' }}">
                                    {{ request.status ?: 'Pending' }}
                                </span>
                            </td>
                            <td class="px-4 py-4 text-slate-700">{{ request.timeIn ? request.timeIn|date('M d, Y H:i') : '-' }}</td>
                            <td class="px-4 py-4 text-slate-700">
                                <div class="flex flex-wrap gap-2">
                                    <a href="{{ path('app_admin_requests_show', {id: request.id, page: currentPage}) }}" class="rounded-md bg-blue-500 px-3 py-1 text-xs font-semibold text-white hover:bg-blue-600">View</a>
                                    <form action="{{ path('app_admin_requests_delete', {id: request.id}) }}" method="post" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-request' ~ request.id) }}">
                                        <input type="hidden" name="page" value="{{ currentPage }}">
                                        <button type="submit" class="rounded-md bg-rose-500 px-3 py-1 text-xs font-semibold text-white hover:bg-rose-600" onclick="return confirm('Delete this request?');">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-slate-500">No requests found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if totalPages > 1 %}
            <nav class="mt-6 flex flex-wrap items-center gap-2 text-sm" aria-label="Pagination">
                {% for page in 1..totalPages %}
                    <a href="{{ path('app_admin_requests', {page: page}) }}" class="inline-flex items-center justify-center rounded-full px-4 py-2 {{ page == currentPage ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' }}">{{ page }}</a>
                {% endfor %}
            </nav>
        {% endif %}
    </section>
</div>
{% endblock %}
