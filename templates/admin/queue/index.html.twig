{% extends 'admin/base.html.twig' %}
{% from 'admin/partials/_components.html.twig' import stat_card %}

{% block admin_title %}Queue{% endblock %}

{% block admin_heading %}Queue Management{% endblock %}

{% block page_actions %}
    {% include 'admin/partials/page_actions.html.twig' %}
{% endblock %}

{% block admin_body %}
<div class="space-y-6">
    <section class="grid gap-4 sm:grid-cols-3">
        {{ stat_card('Open requests', '24', 'Requests waiting in the queue.') }}
        {{ stat_card('In progress', '11', 'Requests currently being handled.') }}
        {{ stat_card('Completed', '9', 'Requests finished today.') }}
    </section>

    <section class="grid gap-4 lg:grid-cols-1">
		<div class="w-full mb-8 overflow-hidden rounded-lg shadow-xs">
			<div class="w-full overflow-x-auto">
                <!-- Search section -->
                <div>

                </div>
				<table class="w-full whitespace-no-wrap">
					<thead>
						<tr class="text-xs font-semibold tracking-wide text-left text-gray-500 uppercase border-b bg-white">
							<th class="px-4 py-3">Interested Party</th>
							<th class="px-4 py-3">Requirement</th>
                            <th class="px-4 py-3">Status</th>
							<th class="px-4 py-3">Time-in</th>
							<th class="px-4 py-3">Time-out</th>
                            <th class="px-4 py-3">Date</th>
                            <th class="px-4 py-3">Actions</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y">
